# Copy to .env and fill in from your Supabase project (Project Settings → API).
# Only Realtime broadcast is used: no tables, no auth. Free projects pause after
# about a week of inactivity, so open the dashboard before a demo.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
